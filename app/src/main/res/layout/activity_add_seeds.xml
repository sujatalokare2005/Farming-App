<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center"
        android:background="#FAF3E0">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/ivProductImage"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Product Image"
            android:padding="4dp"
            android:adjustViewBounds="true"
            android:clipToOutline="true" />

        <!-- Product Name -->
        <EditText
            android:id="@+id/etProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="उत्पादनाचे नाव"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:layout_marginBottom="12dp" />

        <!-- Available Quantity -->
        <EditText
            android:id="@+id/etAvailableQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="उपलब्ध प्रमाण"
            android:inputType="number"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:layout_marginBottom="12dp" />

        <!-- Product Description -->
        <EditText
            android:id="@+id/etProductDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="वर्णन"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:layout_marginBottom="12dp" />

        <!-- Existing Seed Price Field -->
        <EditText
            android:id="@+id/etSeedPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="किंमत"
            android:inputType="number"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:layout_marginBottom="12dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveSeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="जतन करा"
            android:textColor="#000000" />

    </LinearLayout>
</ScrollView>
