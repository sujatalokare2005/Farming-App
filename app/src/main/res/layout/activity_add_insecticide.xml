<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center"
        android:background="#FAF3E0">

        <!-- Insecticide Image -->
        <ImageView
            android:id="@+id/ivInsecticideImage"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Insecticide Image"
            android:padding="4dp"
            android:adjustViewBounds="true"
            android:clipToOutline="true" />

        <!-- Insecticide Name -->
        <EditText
            android:id="@+id/etInsecticideName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="कीटकनाशक नाव"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:layout_marginBottom="12dp"/>

        <!-- Insecticide Price -->
        <EditText
            android:id="@+id/etInsecticidePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="किंमत"
            android:inputType="number"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:layout_marginBottom="12dp"/>

        <!-- Available Quantity -->
        <EditText
            android:id="@+id/etAvailableQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="उपलब्ध प्रमाण"
            android:inputType="number"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:layout_marginBottom="12dp" />

        <!-- Insecticide Description -->
        <EditText
            android:id="@+id/etInsecticideDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="वर्णन"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:layout_marginBottom="12dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveInsecticide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="जतन करा"
            android:textColor="#000000"/>
    </LinearLayout>
</ScrollView>
