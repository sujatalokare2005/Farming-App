<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header / Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌾 कृषी सेवा लॉगिन 🌾"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"/>

        <!-- Professional Marathi Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="शेतकरी बांधवांसाठी – उच्च दर्जाचे खत, कीटकनाशक आणि बियाणे खरेदी करण्यासाठी सुरक्षित आणि सोयीस्कर ऑनलाइन सेवा"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:padding="8dp"/>

        <!-- Farm / Agriculture Image (Before Login Form) -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/img_7"
            android:contentDescription="कृषी सेवा लोगो"
            android:layout_marginBottom="28dp"
            android:scaleType="centerCrop" />

        <!-- नाव (Username Field) -->
        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="तुमचे नाव टाका"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:background="@android:drawable/edit_text" />

        <!-- पासवर्ड (Password Field) -->
        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="पासवर्ड टाका"
            android:inputType="textPassword"
            android:layout_marginBottom="24dp"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:background="@android:drawable/edit_text" />

        <!-- लॉगिन बटण -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="लॉगिन करा"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#1E88E5"
            android:layout_marginBottom="40dp" />

    </LinearLayout>
</ScrollView>
