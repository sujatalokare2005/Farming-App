<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCE4EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- प्रोफाइल चित्र -->
        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/img_3"
            android:contentDescription="प्रोफाइल चित्र"
            android:layout_marginBottom="16dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <!-- स्वागत संदेश -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="आपले कृषी सेवा मध्ये स्वागत आहे 🌾"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <!-- प्रेरणादायी वाक्य -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="शेतकऱ्यांसाठी एक विश्वासार्ह सेवा मंच"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <!-- नाव -->
        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="येथे तुमचे नाव टाका"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:textSize="16sp"
            android:inputType="textPersonName"
            android:textColor="#000000"

            android:textColorHint="#808080" />

        <!-- पासवर्ड -->
        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="खाली तुमचा पासवर्ड टाका"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="24dp"
            android:padding="12dp"
            android:textSize="16sp"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#808080" />

        <!-- लॉगिन बटण -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="लॉगिन करा"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#E91E63"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
